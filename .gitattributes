# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto eol=lf

# Denote all files that are truly binary and should not be modified.

# Common file extensions
*.apk binary
*.apk.* binary
*.apex binary
*.bin binary
*.so binary
*.jar binary
*.pk8 binary
*.ogg binary
*.ico binary
*.jpg binary
*.png binary
*.qmg binary
*.webp binary

# ROM-specific prebuilt blobs
prebuilts/bootable/deprecated-ota/updater binary
prebuilts/*/*/*/** binary
unica/mods/paradigm/system/** binary
unica/mods/prophide/system/bin/rezetprop binary

# Extensionless Exynos9820 HALs and firmware require exact binary bytes.
platform/exynos9820/patches/**/bin/** binary
platform/exynos9820/patches/**/firmware/** binary
*.img binary
*.gz binary
*.zip binary
